# ==========================================================
# Question 1: Using break in a Loop
# ==========================================================
print("--- Question 1 ---")
for num in range(1, 11):
    if num == 5:
        break
    print(num)


# ==========================================================
# Question 2: Using continue in a Loop
# ==========================================================
print("\n--- Question 2 ---")
for num in range(1, 11):
    if num % 3 == 0:
        continue
    print(num)


# ==========================================================
# Question 3: Difference Between break and continue
# ==========================================================
print("\n--- Question 3 ---")
print("Using break:")
for num in range(1, 11):
    if num == 5:
        break
    print(num, end=" ")

print("\n\nUsing continue:")
for num in range(1, 11):
    if num == 5:
        continue
    print(num, end=" ")
print()


# ==========================================================
# Question 4: Searching in a List
# ==========================================================
print("\n--- Question 4 ---")
numbers = [12, 45, 78, 23, 89, 56, 99]
target = int(input("Enter number to search: "))
found_index = -1

for i in range(len(numbers)):
    if numbers[i] == target:
        found_index = i
        break

if found_index != -1:
    print(f"Element found at index position: {found_index}")
else:
    print("Element not found.")


