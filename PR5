# ==========================================================
# Question 6: Skip Negative Numbers
# ==========================================================
print("\n--- Question 6 ---")
numbers_list = [10, -5, 20, -1, 30, -12, 40]
print("Positive numbers only:")
for num in numbers_list:
    if num < 0:
        continue
    print(num, end=" ")
print()


# ==========================================================
# Question 7: Sum of Valid Inputs Only
# ==========================================================
print("\n--- Question 7 ---")
total = 0.0

while True:
    val = float(input("Enter a number (0 to stop): "))
    if val == 0:
        break
    if val < 0:
        print("Negative number ignored.")
        continue
    total += val

print(f"Sum of valid numbers: {total}")


# ==========================================================
# Question 8: Password Retry System
# ==========================================================
print("\n--- Question 8 ---")
correct_password = "python123"

for i in range(1, 4):
    entered_password = input(f"Attempt {i}/3 - Enter password: ")
    if entered_password == correct_password:
        print("Login successful!")
        break
    else:
        print("Incorrect password.")
else:
    # Executes only if the loop was not broken by a correct password
    print("Login failed! You have used all 3 attempts.")


# ==========================================================
# Question 9: Using pass in Empty Blocks
# ==========================================================
print("\n--- Question 9 ---")
# 'pass' acts as a syntactical placeholder where code is required but no action is needed
for num in range(1, 6):
    if num == 3:
        pass  # Placeholder: do nothing when num is 3
    else:
        print(f"Number: {num}")


# ==========================================================
# Question 10: Pattern with Conditional Skipping
# ==========================================================
print("\n--- Question 10 ---")
for row in range(1, 5):
    for col in range(1, 6):
        if col % 2 == 0:
            continue  # Skip even numbers
        print(col, end=" ")
    print()
