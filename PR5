# --- Q1: Using break in a Loop ---
print("Q1 Break at 5:", end=" ")
for i in range(1, 11):
    if i == 5:
        break
    print(i, end=" ")
print()

# --- Q2: Using continue in a Loop ---
print("Q2 Skip multiples of 3:", end=" ")
for i in range(1, 11):
    if i % 3 == 0:
        continue
    print(i, end=" ")
print()

# --- Q3: Difference Between break and continue ---
print("Q3 Break on 5:", [i for i in range(1, 5)])
print("Q3 Continue on 5:", [i for i in range(1, 8) if i != 5])

# --- Q4: Searching in a List using break ---
nums = [12, 45, 78, 34, 89, 23]
target = 34
for idx, val in enumerate(nums):
    if val == target:
        print(f"Q4: Found {target} at index {idx}")
        break

# --- Q5: First Divisible Number Finder ---
n = 17
for i in range(1, 101):
    if i % n == 0:
        print(f"Q5: First number between 1-100 divisible by {n} is {i}")
        break

# --- Q6: Skip Negative Numbers ---
mixed_list = [10, -5, 22, -18, 0, 35, -2]
print("Q6 Positive numbers only:", end=" ")
for x in mixed_list:
    if x < 0:
        continue
    print(x, end=" ")
print()

# --- Q7: Sum of Valid Inputs Only ---
valid_sum = 0
while True:
    val = int(input("Q7 Enter number (0 to stop, negatives ignored): "))
    if val == 0:
        break
    if val < 0:
        continue
    valid_sum += val
print("Q7 Sum of valid inputs:", valid_sum)

# --- Q8: Password Retry System ---
secret = "admin123"
for attempt in range(1, 4):
    pwd = input(f"Q8 Attempt {attempt}/3 - Enter Password: ")
    if pwd == secret:
        print("Q8: Access Granted!")
        break
else:
    print("Q8: Account Locked! 3 failed attempts.")

