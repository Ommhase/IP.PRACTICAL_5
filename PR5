# --- Q10: Pattern with Conditional Skipping (Skip Even Numbers) ---
print("Q10 Pattern skipping multiples of 2:")
for i in range(1, 4):
    for j in range(1, 6):
        if j % 2 == 0:
            continue
        print(j, end=" ")
    print()
