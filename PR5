<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>JavaScript Basics and Validation</title>
</head>
<body>
    <h1>JavaScript Demonstration</h1>

    <!-- Display Message -->
    <button onclick="showMessage()">Display Message</button>
    <p id="message"></p>

    <!-- Calculator -->
    <h2>Calculator</h2>
    <label>First number: <input type="number" id="a" value="10"></label><br><br>
    <label>Second number: <input type="number" id="b" value="5"></label><br><br>
    <button onclick="calculate()">Calculate</button>
    <p id="mathResult"></p>

    <!-- Date & Time -->
    <h2>Current Date and Time</h2>
    <p id="datetime"></p>

    <!-- Form Validation -->
    <h2>Technology Form</h2>
    <form onsubmit="return validateForm()">
        <label>Technology: <input type="text" id="technology" required></label><br><br>
        <label>Email: <input type="email" id="email" required></label><br><br>
        <label>Contact (10 digits): <input type="text" id="contact" required></label><br><br>
        
        <label>Category:
            <select id="category" required>
                <option value="">Choose</option>
                <option value="AI">AI</option>
                <option value="Cloud">Cloud Computing</option>
                <option value="Cyber">Cyber Security</option>
                <option value="IoT">IoT</option>
            </select>
        </label><br><br>

        Impact:
        <label><input type="radio" name="impact" value="High"> High</label>
        <label><input type="radio" name="impact" value="Medium"> Medium</label>
        <label><input type="radio" name="impact" value="Low"> Low</label><br><br>

        Areas:
        <label><input type="checkbox" name="areas" value="Healthcare"> Healthcare</label>
        <label><input type="checkbox" name="areas" value="Education"> Education</label><br><br>

        <button type="submit">Validate</button>
    </form>

    <script>
        function showMessage() {
            document.getElementById('message').textContent = 'Welcome to JavaScript!';
        }

        function calculate() {
            const a = Number(document.getElementById('a').value);
            const b = Number(document.getElementById('b').value);
            let result = `Addition: ${a + b} | Subtraction: ${a - b} | Multiplication: ${a * b} | `;
            result += (b !== 0) ? `Division: ${a / b}` : 'Division: Cannot divide by zero';
            document.getElementById('mathResult').textContent = result;
        }

        document.getElementById('datetime').textContent = new Date().toLocaleString();

        function validateForm() {
            const technology = document.getElementById('technology').value.trim();
            const email = document.getElementById('email').value.trim();
            const contact = document.getElementById('contact').value.trim();
            const category = document.getElementById('category').value;

            if (!technology) {
                alert('Enter a technology name');
                return false;
            }

            const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            if (!emailRegex.test(email)) {
                alert('Enter a valid email');
                return false;
            }

            const phoneRegex = /^[0-9]{10}$/;
            if (!phoneRegex.test(contact)) {
                alert('Enter a 10-digit contact number');
                return false;
            }

            if (!category) {
                alert('Select a category');
                return false;
            }

            if (!document.querySelector('input[name="impact"]:checked')) {
                alert('Select impact level');
                return false;
            }

            if (!document.querySelector('input[name="areas"]:checked')) {
                alert('Select at least one application area');
                return false;
            }

            alert('All fields are valid!');
            return true;
        }
    </script>
</body>
</html>
