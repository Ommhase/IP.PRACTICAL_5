<!-- ==========================================================
     Question 2: Mathematical Operations
     ========================================================== -->
<script>
    let a = 10, b = 5;
    document.write('Addition = ' + (a + b) + '<br>');
    document.write('Subtraction = ' + (a - b) + '<br>');
    document.write('Multiplication = ' + (a * b) + '<br>');
    document.write('Division = ' + (b !== 0 ? (a / b) : 'Cannot divide by zero') + '<br>');
</script>


